# Local evaluation only: replace credentials before an exposed deployment.
POSTGRES_DB=ecoroute
POSTGRES_USER=ecoroute
POSTGRES_PASSWORD=ecoroute_demo_change_me
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Obtain a browser token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# true: synthetic demo graph only if the team's PostGIS has no roads
ECOROUTE_ALLOW_DEMO_GRAPH=true
ROUTING_WORKERS=2
ML_INTERVAL_SECONDS=300
ROUTE_PREFETCH=true
# Optional OSM ingestion (uses Overpass network access)
INGEST_ADDRESS=Shivaji Nagar, Pune, India
INGEST_RADIUS_METERS=2000
